{
  "name": "brasil-api-client",
  "version": "1.0.0",
  "description": "Cliente TypeScript/JavaScript para a Brasil API (brasilapi.com.br) - API pública de dados brasileiros",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "dev:server": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,html}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "brasilapi",
    "brazil",
    "api",
    "cep",
    "cnpj",
    "cpf",
    "banks",
    "holidays",
    "fipe",
    "ibge",
    "isbn",
    "ncm",
    "ddd",
    "typescript",
    "javascript",
    "client"
  ],
  "author": "Marcolino-Dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marcolino-Dev/brasil-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/Marcolino-Dev/brasil-api-client/issues"
  },
  "homepage": "https://github.com/Marcolino-Dev/brasil-api-client#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^4.22.3"
  }
}